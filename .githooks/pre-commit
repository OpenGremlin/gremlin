#!/bin/sh
set -e

echo "Running pre-commit checks..."

echo "→ Lint"
pnpm lint

echo "→ Build & Typecheck"
pnpm turbo build --filter @gremlin/server --filter @gremlin/mobile
pnpm --filter @gremlin/server exec tsc --noEmit
pnpm --filter @gremlin/mobile exec tsc --noEmit

echo "→ Codegen"
pnpm --filter @gremlin/server codegen
pnpm --filter @gremlin/mobile codegen
if ! git diff --quiet; then
  echo "ERROR: Codegen produced uncommitted changes. Please commit them before pushing."
  git diff --stat
  exit 1
fi

echo "→ Tests"
pnpm --filter @gremlin/server test

echo "All checks passed."
