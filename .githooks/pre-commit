#!/bin/sh
set -e

echo "Running pre-commit checks..."

echo "→ Lint"
pnpm lint

echo "→ Build & Typecheck"
pnpm turbo build --filter @opengremlin/server --filter @opengremlin/mobile
pnpm --filter @opengremlin/server exec tsc --noEmit
pnpm --filter @opengremlin/mobile exec tsc --noEmit

echo "→ Codegen"
pnpm --filter @opengremlin/server codegen
pnpm --filter @opengremlin/mobile codegen
if ! git diff --quiet; then
  echo "ERROR: Codegen produced uncommitted changes. Please commit them before pushing."
  git diff --stat
  exit 1
fi

echo "→ Tests"
pnpm --filter @opengremlin/server test

echo "All checks passed."
