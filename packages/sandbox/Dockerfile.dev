# Dev sandbox: same runtime tools as prod, but with tsx --watch and volume mounts
# Used by docker-compose.yml for local development

# Stage 1: install dependencies (reused from prod Dockerfile)
FROM node:20-slim AS deps
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git && rm -rf /var/lib/apt/lists/*
RUN corepack enable
RUN git init
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/sandbox/package.json packages/sandbox/
RUN pnpm install --frozen-lockfile \
    && test -f node_modules/.pnpm/node-pty@*/node_modules/node-pty/build/Release/pty.node \
    || (echo "FATAL: node-pty native build missing" && exit 1)

# Stage 2: runtime with dev tools
FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      jq curl wget git unzip python3 python3-pip python3-venv \
      build-essential pkg-config libssl-dev \
      iputils-ping dnsutils procps \
    && rm -rf /var/lib/apt/lists/*

# Go
ENV GOLANG_VERSION=1.22.5
RUN ARCH=$(dpkg --print-architecture) && \
    curl -fsSL "https://go.dev/dl/go${GOLANG_VERSION}.linux-${ARCH}.tar.gz" \
    | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# Rust
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path
ENV PATH="/usr/local/cargo/bin:${PATH}"

# AWS CLI
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$(uname -m).zip" -o /tmp/awscliv2.zip && \
    unzip -qo /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# MCPorter
RUN npm install -g mcporter

WORKDIR /app

# Node modules (including native node-pty)
COPY --from=deps /build/node_modules/ node_modules/
COPY --from=deps /build/packages/sandbox/node_modules/ packages/sandbox/node_modules/
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./

COPY packages/sandbox/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Non-root user for agent shell
RUN apt-get update && apt-get install -y --no-install-recommends sudo && rm -rf /var/lib/apt/lists/* \
    && (userdel -r node 2>/dev/null || true) \
    && useradd -m -s /bin/bash -u 1000 sandbox \
    && echo "sandbox ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt" > /etc/sudoers.d/sandbox \
    && mkdir -p /workspace \
    && chown sandbox:sandbox /workspace

EXPOSE 8080 8083
ENTRYPOINT ["/app/entrypoint.sh"]
WORKDIR /app/packages/sandbox
# tsx watch picks up source changes via volume mount
CMD ["npx", "tsx", "watch", "src/index.ts"]
