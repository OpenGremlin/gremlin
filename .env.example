# AWS / Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# DynamoDB
DYNAMODB_TABLE_NAME=gremlin
SECRETS_TABLE_NAME=gremlin-secrets

# Admin (Vite)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Server
PORT=3001
MEDIA_CDN_URL=
SKIP_AUTH=true
VITE_SKIP_AUTH=true
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# S3 Vectors
S3_VECTORS_BUCKET_NAME=gremlin-vectors

# Workspace (file browser)
WORKSPACE_PATH=./workspace

# ECS / Sandbox
ECS_CLUSTER_NAME=
SUBNET_IDS=
SANDBOX_TASK_DEF_ARN=
SANDBOX_SG_ID=

# Local sandbox (set to true + run: pnpm --filter @gremlin/sandbox dev)
# SANDBOX_LOCAL=true
# SANDBOX_LOCAL_WS_URL=ws://localhost:8080

# Messaging / SQS / Scheduler
DOORBELL_QUEUE_URL=
SCHEDULE_TARGET_LAMBDA_ARN=
SCHEDULER_ROLE_ARN=

# Logging – set to true to write logs to logs/{server,sandbox}/{hour}.log
# ENABLE_FILE_LOGS=true

# Local infrastructure (uncomment for local dev with docker-compose)
# LOCALSTACK_ENDPOINT=http://localhost:4566
# DOORBELL_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gremlin-doorbell
