# AWS / Cognito – required for mobile app (uses real auth flow even in local dev)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# DynamoDB
GREMLIN_TABLE_NAME=gremlin
CHAT_TABLE_NAME=gremlin-chat
SECRETS_TABLE_NAME=gremlin-secrets

# Server
PORT=3001
SKIP_AUTH=true
REDIRECT_URI=http://localhost:5173
API_URL=http://localhost:3001

# Canvas page origin (unset = https://ogcaster.com). Override to point
# the mobile "Open in browser" flow at a locally-running canvas app.
# CANVAS_BASE_URL=http://localhost:5173

# S3 Vectors (not supported by LocalStack) – leave empty to disable agent memory features (only required in prod)
VECTORS_BUCKET=

# Skills – leave empty to read from local packages/lib/skills/ (only required in prod)
SKILLS_BUCKET=

# Workspace (file browser)
WORKSPACE_PATH=./workspace

# ECS / Sandbox (prod only – no need to set locally)
ECS_CLUSTER_NAME=
SUBNET_IDS=
SANDBOX_TASK_DEF_ARN=
SANDBOX_SECURITY_GROUP_ID=

# Local sandbox (set to true + run: pnpm --filter @gremlin/sandbox dev)
SANDBOX_LOCAL=true
SANDBOX_LOCAL_WS_URL=ws://localhost:8080
SANDBOX_USER=root

# Messaging / SQS / Scheduler
DOORBELL_SQS_URL=http://localhost:4566/000000000000/gremlin-doorbell
SCHEDULE_TARGET_QUEUE_ARN=arn:aws:sqs:us-east-1:000000000000:gremlin-doorbell
SCHEDULER_ROLE_ARN=arn:aws:iam::000000000000:role/local-scheduler-role

# Logging – set to true to write logs to logs/{server,sandbox}/{hour}.log
ENABLE_FILE_LOGS=true

# Local infrastructure (LocalStack)
# Get your auth token at https://app.localstack.cloud/settings/auth-tokens
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_ENDPOINT=http://localhost:4566
