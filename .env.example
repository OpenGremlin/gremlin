# AWS / Cognito
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

# DynamoDB
DYNAMODB_TABLE_NAME=gremlin
SECRETS_TABLE_NAME=gremlin-secrets

# Admin (Vite)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
