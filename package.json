{
  "name": "gremlin",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @opengremlin/server dev",
    "mobile": "pnpm --filter @opengremlin/mobile dev",
    "canvas": "pnpm --filter @opengremlin/canvas dev",
    "gremlin": "pnpm --filter @opengremlin/cli gremlin",
    "build": "turbo build",
    "clean": "turbo clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo test",
    "format": "biome format --write .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "turbo": "^2"
  },
  "packageManager": "pnpm@9.15.0"
}
