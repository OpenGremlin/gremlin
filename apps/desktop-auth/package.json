{
  "name": "@gremlin/desktop-auth",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "pnpm build:main && concurrently -k \"vite --port 5174\" \"VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build:main": "node build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "arctic": "^3.5.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.2",
    "@graphql-codegen/client-preset": "^5.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "esbuild": "^0.25.0",
    "graphql": "^16.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6"
  }
}
