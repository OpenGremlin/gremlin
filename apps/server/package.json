{
  "name": "@gremlin/server",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:export": "tsx scripts/exportSchema.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:seed": "tsx scripts/seed-local.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-scheduler": "^3.1001.0",
    "@aws-sdk/client-sqs": "^3.1001.0",
    "@aws-sdk/client-ssm": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/schema": "^10.0.31",
    "@graphql-yoga/subscription": "^5.0.5",
    "@gremlin/lib": "workspace:*",
    "cron-parser": "^5.5.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.3.1",
    "dynamodb-toolbox": "^2.8.0",
    "express": "^4",
    "graphql": "^16.13.0",
    "graphql-ws": "^6.0.7",
    "graphql-yoga": "^5.18.0",
    "image-size": "^2.0.2",
    "jose": "^6",
    "sharp": "^0.33",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.2",
    "@graphql-codegen/typescript": "^5.0.8",
    "@graphql-codegen/typescript-resolvers": "^5.1.6",
    "@graphql-tools/utils": "^11.0.0",
    "@types/express": "^4",
    "@types/node": "^22",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
