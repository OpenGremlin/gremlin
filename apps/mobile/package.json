{
  "name": "@opengremlin/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 expo start --dev-client",
    "go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/generateSchemaHash.mjs",
    "build:web": "expo export --platform web",
    "build:submit:ios": "NODE_ENV=production eas build --platform ios --profile preview --non-interactive && eas submit --platform ios --latest --non-interactive",
    "build:submit:ios:local": "NODE_ENV=production eas build --platform ios --profile preview --local --non-interactive --output ./build.ipa && eas submit --platform ios --path ./build.ipa --non-interactive",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@expo/dom-webview": "^55.0.5",
    "@expo/metro-runtime": "~55.0.9",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/crashlytics": "^24.0.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/native": "^7.2.2",
    "@shopify/react-native-skia": "2.4.18",
    "apollo3-cache-persist": "^0.15.0",
    "babel-preset-expo": "~55.0.8",
    "cronstrue": "^3.13.0",
    "expo": "~55.0.12",
    "expo-asset": "~55.0.13",
    "expo-audio": "~55.0.12",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.14",
    "expo-clipboard": "~55.0.12",
    "expo-constants": "~55.0.12",
    "expo-crypto": "^55.0.13",
    "expo-dev-client": "~55.0.23",
    "expo-document-picker": "^55.0.12",
    "expo-file-system": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.13",
    "expo-image": "^55.0.8",
    "expo-image-manipulator": "~55.0.14",
    "expo-image-picker": "~55.0.17",
    "expo-linear-gradient": "^55.0.12",
    "expo-linking": "~55.0.11",
    "expo-media-library": "^55.0.13",
    "expo-print": "~55.0.12",
    "expo-router": "~55.0.11",
    "expo-secure-store": "~55.0.12",
    "expo-sharing": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "expo-video": "~55.0.14",
    "expo-web-browser": "^55.0.13",
    "graphql": "^16.13.0",
    "graphql-ws": "^6.0.7",
    "lucide-react-native": "^0.577.0",
    "marked": "^18.0.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.4",
    "react-native-css-interop": "^0.2.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-google-cast": "^4.9.1",
    "react-native-marked": "^8.0.1",
    "react-native-pdf-renderer": "^2.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "~0.7.2",
    "react-qr-code": "^2.0.15"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.2",
    "@graphql-codegen/client-preset": "^5.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.1.11",
    "expo-mcp": "~0.2.1",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  }
}
